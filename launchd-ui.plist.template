<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>at.dasgeht.callnotes-ui</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/CallNotes.app/Contents/MacOS/CallNotes</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Neu starten, wenn macOS die App abbricht (z. B. 'Code Signature Invalid' beim
	     ersten Start direkt nach einem Update) - nicht, wenn man sie selbst beendet. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardOutPath</key>
	<string>__HOME__/CallNotes/log/ui.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/CallNotes/log/ui.log</string>
</dict>
</plist>
